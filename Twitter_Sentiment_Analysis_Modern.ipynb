   "metadata": {},
   "outputs": [],
   "source": [
    "import pathlib, sys\n",
    "\n",
    "# Adjust this path if you place the project folder elsewhere in Colab\n",
    "project_root = pathlib.Path.cwd()\n",
    "sys.path.append(str(project_root))\n",
    "\n",
    "from twitter_sentiment import AnalysisConfig, analyze_user\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Choose any handle (without the @)\n",
    "username = \"BillGates\"\n",
    "config = AnalysisConfig(tweets_limit=120)\n",
    "\n",
    "df, dist_plot, trend_plot = analyze_user(username, config=config)\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from IPython.display import Image, display\n",
    "\n",
    "display(Image(filename=dist_plot))\n",
    "display(Image(filename=trend_plot))\n"
   ]
  }
